# =============================================================================
# HotelOps Production Environment Variables
# Copy this to .env and fill in all values
# =============================================================================

# -----------------------------------------------------------------------------
# DOMAIN & NETWORK
# -----------------------------------------------------------------------------
DOMAIN=yourdomain.com                    # Your production domain (e.g., hotelops.example.com)
# CADDY_EMAIL=admin@yourdomain.com        # For Let's Encrypt certificates

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL) - Use Neon, Supabase, or self-hosted
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database?schema=public&sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# If using self-hosted PostgreSQL in Docker:
# DATABASE_URL=postgresql://hotelops:CHANGE_ME@db:5432/hotelops?schema=public
# DIRECT_URL=postgresql://hotelops:CHANGE_ME@db:5432/hotelops?schema=public

# Database credentials (for docker-compose.prod.yml)
DB_USER=hotelops
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=hotelops

# -----------------------------------------------------------------------------
# REDIS - Use Upstash, Redis Cloud, or self-hosted
# -----------------------------------------------------------------------------
# Format: redis://:password@host:port  (TCP for BullMQ)
# Format: rediss://:password@host:port (TLS for Upstash)
REDIS_URL=redis://:password@host:port

# Redis password (for docker-compose.prod.yml)
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# JWT SECRETS - Generate with: openssl rand -base64 32
# MUST be at least 32 characters
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_32_PLUS_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_32_PLUS_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
API_PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com

# -----------------------------------------------------------------------------
# FRONTEND (Next.js) - Set in Vercel dashboard
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
# NEXT_PUBLIC_WS_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# EMAIL / SMTP (Optional - for password reset emails)
# -----------------------------------------------------------------------------
EMAIL_DEV_MODE=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM="HotelOps <no-reply@yourdomain.com>"
FRONTEND_URL=https://yourdomain.com

# Alternative SMTP providers:
# Mailgun:    SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
# Postmark:   SMTP_HOST=smtp.postmarkapp.com, SMTP_PORT=587
# AWS SES:    SMTP_HOST=email-smtp.us-east-1.amazonaws.com, SMTP_PORT=587
# Gmail:      SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (use App Password)

# -----------------------------------------------------------------------------
# OPTIONAL: Monitoring & Analytics
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOGTAIL_TOKEN=xxx